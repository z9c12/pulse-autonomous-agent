# Solana wallet private key (base58) — used for SAP agent registration
# Create a fresh wallet with: solana-keygen new
SOLANA_PRIVATE_KEY=your_base58_private_key_here

# Synapse RPC endpoint (free tier at oobeprotocol.ai)
SYNAPSE_RPC_URL=https://us-1-mainnet.oobeprotocol.ai/rpc?api_key=YOUR_KEY

# Ace Data Cloud API key (get free credits at platform.acedata.cloud)
ACE_API_KEY=your_ace_data_cloud_api_key_here

# EVM wallet private key for x402 payments on Base (0x...)
# Fund with a tiny amount of USDC on Base for x402 payments
EVM_PRIVATE_KEY=0x_your_evm_private_key_here

# Supabase (free tier at supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# How often the agent runs (milliseconds). Default: 2 minutes
INTERVAL_MS=120000
